# Copy to .env.local for local use. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# A long random code you type once on the /setup page to create your password.
# Generate one: openssl rand -base64 24   (or any 20+ random characters)
SETUP_TOKEN=change-me-to-a-long-random-string

# Optional
# DATABASE_SSL=disable          # only for a local Postgres without SSL
# DATABASE_POOL_MAX=5
# TEST_DATABASE_URL=postgresql://...   # a SEPARATE empty database used by `npm test`
